{
  "name": "@sphere-chat/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Sphere を Claude Code 等の MCP クライアントから使うためのローカル MCP サーバー（個人用 API トークンで /api/token/* を呼ぶ）",
  "type": "module",
  "bin": {
    "sphere-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "compile": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check-dist": "npm run compile && test -z \"$(git status --porcelain -- dist)\"",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
